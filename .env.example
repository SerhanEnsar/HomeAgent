# HomeAgent Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Session signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_a_random_secret

# API key used by mobile/Wear OS/ESP32 clients
API_KEY=change_me_to_a_random_api_key

# Web panel login credentials
USERNAME=admin
PASSWORD=change_me_on_first_login

# Telegram Bot (optional)
# TG_TOKEN=
# TG_CHAT_ID=
